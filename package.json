{
  "name": "bvac-team-builder",
  "private": true,
  "description": "Companion team-placement and scheduling tool for BVAC youth sports, built to run alongside SportsEngine.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @bvac/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "seed": "pnpm --filter @bvac/seed generate",
    "check": "pnpm typecheck && pnpm test"
  }
}
